#!/bin/bash
# Fake security: the keychain is the folder $FAKE_KEYCHAIN, with a file named <service>.<account> per password. Knows
#   find-generic-password -s <service> -a <account> [-w]
#   delete-generic-password -s <service> -a <account>
#   -i, reading lines like  add-generic-password -U -s <service> -a <account> -w "<password>"  from stdin
# Every command line goes to $FAKE_KEYCHAIN/argv, to check that no token is on one.
printf '%s\n' "$*" >>"$FAKE_KEYCHAIN/argv"

if [[ $1 == -i ]]; then
	add_pattern='^add-generic-password -U -s ([^ ]+) -a ([^ ]+) -w "([^"]*)"$'
	while IFS= read -r line; do
		[[ $line =~ $add_pattern ]] && printf '%s' "${BASH_REMATCH[3]}" >"$FAKE_KEYCHAIN/${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
	done
	exit 0
fi

command=$1
shift
service='' account='' print=0
while (($#)); do
	case $1 in
		-s) service=$2; shift ;;
		-a) account=$2; shift ;;
		-w) print=1 ;;
	esac
	shift
done
file="$FAKE_KEYCHAIN/$service.$account"
if [[ ! -f $file ]]; then
	echo 'security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain.' >&2
	exit 44
fi
case $command in
	find-generic-password) ((print)) && cat "$file" ;;
	delete-generic-password) rm "$file" ;;
esac
exit 0
