#!/bin/bash
# Watches a Jenkins build and raises a loud alert (dialog, sound, voice, banner) when it finishes.
set -uo pipefail

# Usually started through the ~/bin symlink; the icons and the notifier live next to the real file.
script=$0
[[ -L $script ]] && script=$(readlink "$script")
TOOL_DIR="$(cd "$(dirname "$script")/.." && pwd)"
ICON_DIR="$TOOL_DIR/icons"
NOTIFIER="$TOOL_DIR/notifier/Jenkins Watch.app/Contents/MacOS/jenkins-notifier"
team_file="$TOOL_DIR/config/team.conf"

# Where Jenkins and GitLab live and the team's label conventions: config/team.conf, see config/team.example.conf.
team_value() {
	awk -v key="$1" 'index($0, key "=") == 1 { value = substr($0, length(key) + 2) } END { print value }' "$team_file" 2>/dev/null
}

JOB_ROOT=$(team_value jenkins_job_url)
JOB_ROOT=${JOB_ROOT%/}

interval=60
voice=0
dialog=1
wait_next=0
test_mode=0
target=''
build=''

usage() {
	cat <<EOF
Usage: jenkins-watch [options] <MR number | Jenkins job URL | Jenkins build URL>

  jenkins-watch 123                    watch the latest build of MR-123
  jenkins-watch <.../job/MR-123/2/>    watch build #2 of that job
  jenkins-watch --next 123             wait for the next build to start, then watch it (use right after a push)
  jenkins-watch --test                 fire a sample alert to see what it looks like

Options:
  -n, --next          ignore the current build and watch the next one
  -i, --interval SEC  poll interval in seconds (default: $interval)
  --voice             also announce the result out loud
  --banner            show a banner only, no dialog
  -t, --test          show a sample success alert and exit
  --test-failure      show a sample failure alert and exit
  -h, --help          show this help

Credentials: \$JENKINS_MCP_BASIC_AUTH (base64 of user:token), or \$JENKINS_USER plus \$JENKINS_TOKEN, or
JENKINS_MCP_BASIC_AUTH in the keychain (service jenkins-menubar, see the README).
Exit status: 0 when the build succeeded, 1 otherwise.
EOF
}

die() {
	printf '\njenkins-watch: %s\n' "$*" >&2
	exit 2
}

while (($#)); do
	case $1 in
		-n | --next) wait_next=1 ;;
		-i | --interval) interval=${2:?--interval needs a value}; shift ;;
		--voice) voice=1 ;;
		--banner) dialog=0 ;;
		-t | --test) test_mode=1 ;;
		--test-failure) test_mode=2 ;;
		-h | --help) usage; exit 0 ;;
		-*) die "unknown option $1 (see --help)" ;;
		*) target=$1 ;;
	esac
	shift
done

[[ -n $JOB_ROOT ]] || die "set jenkins_job_url in $team_file (see config/team.example.conf)"

format_duration() {
	printf '%dh%02dm' $(($1 / 3600)) $(($1 % 3600 / 60))
}

# Posts a macOS banner through Jenkins Watch.app; a plain AppleScript one (no buttons) when the app is missing or not allowed.
banner() {
	local title=$1 body=$2 build_url=$3 mr_url=$4 default_link=$5
	"$NOTIFIER" --title "$title" --body "$body" --build "$build_url" ${mr_url:+--mr "$mr_url"} --default "$default_link" >/dev/null 2>&1 && return
	osascript - "$title" "$body" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
	display notification (item 2 of argv) with title (item 1 of argv)
end run
APPLESCRIPT
}

announce() {
	local result=$1 headline=$2 title=$3 facts=$4 url=$5 mr_url=${6:-} sound spoken
	case $result in
		SUCCESS) headline="✅ $headline"; sound=Glass; spoken='is green' ;;
		UNSTABLE) headline="⚠️ $headline"; sound=Funk; spoken='is unstable' ;;
		FAILURE) headline="❌ $headline"; sound=Basso; spoken='failed' ;;
		ABORTED) headline="⏹ $headline"; sound=Submarine; spoken='was aborted' ;;
		*) headline="❔ $headline"; sound=Ping; spoken="finished with $result" ;;
	esac

	afplay "/System/Library/Sounds/$sound.aiff" &
	if ((voice)); then
		say "Jenkins build $spoken" &
	fi
	local body=$facts icon="$ICON_DIR/sad.png" default_link=build
	[[ -n $title ]] && body="$title"$'\n'"$facts"
	[[ $result == SUCCESS ]] && icon="$ICON_DIR/happy.png"
	[[ $result == SUCCESS && -n $mr_url ]] && default_link=mr
	banner "$headline" "$body" "$url" "$mr_url" "$default_link"
	((dialog)) || return 0

	local alert_script answer default_button='Open build'
	[[ $default_link == mr ]] && default_button='Open MR'
	read -r -d '' alert_script <<'JXA'
ObjC.import('Cocoa');

const WIDTH = 248;

ObjC.registerSubclass({
	name: 'JenkinsAlertTarget',
	methods: {
		'choose:': {
			types: ['void', ['id']],
			implementation: sender => $.NSApplication.sharedApplication.stopModalWithCode(sender.tag),
		},
	},
});

function label(text, font, color, alignment) {
	const field = $.NSTextField.wrappingLabelWithString(text);
	field.font = font;
	field.textColor = color;
	field.alignment = alignment;
	field.preferredMaxLayoutWidth = WIDTH;
	return fixedSize(field, WIDTH);
}

function fixedSize(view, width, height) {
	view.translatesAutoresizingMaskIntoConstraints = false;
	view.widthAnchor.constraintEqualToConstant(width).active = true;
	if (height) {
		view.heightAnchor.constraintEqualToConstant(height).active = true;
	}
	return view;
}

function run(argv) {
	const [headline, title, facts, iconPath, withMergeRequest, defaultButton, architecture] = argv;
	const app = $.NSApplication.sharedApplication;
	app.setActivationPolicy(1);

	// AppKit uses the iOS NSTextAlignment values on Apple Silicon, where center is 1; the bridge only knows the Intel value 2.
	const center = architecture === 'arm64' ? 1 : 2;
	const texts = [label(headline, $.NSFont.boldSystemFontOfSize(14), $.NSColor.labelColor, center)];
	if (title) {
		texts.push(label(title, $.NSFont.systemFontOfSize(12), $.NSColor.labelColor, center));
	}
	if (facts) {
		texts.push(label(facts, $.NSFont.systemFontOfSize(11), $.NSColor.secondaryLabelColor, center));
	}

	const choices = withMergeRequest === '1' ? ['Open build', 'Open MR', 'Dismiss'] : ['Open build', 'Dismiss'];
	const titles = [defaultButton].concat(choices.filter(choice => choice !== defaultButton));
	const target = $.JenkinsAlertTarget.alloc.init;
	const buttons = titles.map((buttonTitle, index) => {
		const button = $.NSButton.buttonWithTitleTargetAction(buttonTitle, target, 'choose:');
		button.controlSize = 3;
		button.tag = index;
		if (index === 0) {
			button.keyEquivalent = '\r';
			// The default button is only drawn blue while the panel has keyboard focus, which it usually does not.
			if (button.respondsToSelector('setTintProminence:')) {
				button.setTintProminence(2);
			}
			button.bezelColor = $.NSColor.controlAccentColor;
		} else if (buttonTitle === 'Dismiss') {
			button.keyEquivalent = '\x1b';
		}
		return fixedSize(button, WIDTH);
	});

	const icon = $.NSImage.alloc.initWithContentsOfFile(iconPath);
	const views = icon.isNil() ? [] : [fixedSize($.NSImageView.imageViewWithImage(icon), 96, 96)];
	const stack = $.NSStackView.stackViewWithViews($(views.concat(texts, buttons)));
	stack.orientation = 1;
	stack.alignment = 9;
	stack.spacing = 8;
	stack.translatesAutoresizingMaskIntoConstraints = false;
	if (views.length) {
		stack.setCustomSpacingAfterView(12, views[0]);
	}
	texts.slice(0, -1).forEach(text => stack.setCustomSpacingAfterView(3, text));
	stack.setCustomSpacingAfterView(18, texts[texts.length - 1]);

	const background = $.NSVisualEffectView.alloc.init;
	background.material = 6;
	background.state = 1;
	background.addSubview(stack);
	stack.topAnchor.constraintEqualToAnchorConstant(background.topAnchor, 22).active = true;
	stack.bottomAnchor.constraintEqualToAnchorConstant(background.bottomAnchor, -16).active = true;
	stack.leadingAnchor.constraintEqualToAnchorConstant(background.leadingAnchor, 16).active = true;
	stack.trailingAnchor.constraintEqualToAnchorConstant(background.trailingAnchor, -16).active = true;

	const panel = $.NSPanel.alloc.initWithContentRectStyleMaskBackingDefer($.NSMakeRect(0, 0, WIDTH + 32, 300), 1 | 128 | 32768, 2, false);
	panel.titlebarAppearsTransparent = true;
	panel.titleVisibility = 1;
	[0, 1, 2].forEach(kind => {
		panel.standardWindowButton(kind).hidden = true;
	});
	panel.movableByWindowBackground = true;
	panel.contentView = background;
	panel.setContentSize(background.fittingSize);
	// A background process cannot take focus, so the panel floats above other windows on every Space instead.
	panel.hidesOnDeactivate = false;
	panel.level = 25;
	panel.collectionBehavior = 1 | 256;
	panel.center;
	const response = app.runModalForWindow(panel);
	panel.orderOut(null);
	return titles[response];
}
JXA
	answer=$(osascript -l JavaScript - "$headline" "$title" "$facts" "$icon" "${mr_url:+1}" "$default_button" "$(uname -m)" 2>/dev/null <<<"$alert_script")
	case $answer in
		'Open build') open "$url" ;;
		'Open MR') open "$mr_url" ;;
	esac
}

if ((test_mode)); then
	gitlab_url=$(team_value gitlab_url)
	sample_mr_url=${gitlab_url:+${gitlab_url%/}/$(team_value gitlab_project)/-/merge_requests}
	if ((test_mode == 2)); then
		announce FAILURE 'MR-123 #2 FAILURE' 'This is what a failed build looks like.' \
			$'Duration: 2h31m\nFailed tests: 3 of 1200\nFailed stages: integration-tests' "$JOB_ROOT" "$sample_mr_url"
	else
		announce SUCCESS 'MR-123 #2 SUCCESS' 'This is what a finished build looks like.' 'Duration: 4h12m' "$JOB_ROOT" "$sample_mr_url"
	fi
	exit 0
fi

[[ -n $target ]] || { usage >&2; exit 2; }

if [[ -n ${JENKINS_MCP_BASIC_AUTH:-} ]]; then
	auth=$JENKINS_MCP_BASIC_AUTH
elif [[ -n ${JENKINS_USER:-} && -n ${JENKINS_TOKEN:-} ]]; then
	auth=$(printf '%s:%s' "$JENKINS_USER" "$JENKINS_TOKEN" | base64)
elif ! auth=$(security find-generic-password -s jenkins-menubar -a JENKINS_MCP_BASIC_AUTH -w 2>/dev/null); then
	die 'no Jenkins credentials: set JENKINS_MCP_BASIC_AUTH, or JENKINS_USER and JENKINS_TOKEN, or use the keychain (see --help)'
fi

# Sets $body. Returns 0 on success, 1 on a transient failure, 2 when retrying cannot help.
# The token goes to curl through a file descriptor, so it does not show up in ps.
api() {
	local response status
	response=$(curl -sS --max-time 30 -w '\n%{http_code}' -H @<(printf 'Authorization: Basic %s\n' "$auth") "$1" 2>/dev/null) || return 1
	status=${response##*$'\n'}
	body=${response%$'\n'*}
	case $status in
		200) return 0 ;;
		401 | 403 | 404) last_error="HTTP $status for $1"; return 2 ;;
		*) return 1 ;;
	esac
}

fetch() {
	local failures=0 code
	while true; do
		api "$1"
		code=$?
		((code == 0)) && return 0
		((code == 2)) && die "$last_error"
		failures=$((failures + 1))
		((failures >= 10)) && die "Jenkins unreachable after $failures attempts"
		sleep "$interval"
	done
}

target=${target%%[?#]*}
mr_pattern='^(MR-|!)?([0-9]+)$'
build_pattern='^(https?://.*/job/[^/]+)/([0-9]+)(/.*)?$'
job_pattern='^(https?://.*/job/[^/]+)(/.*)?$'
if [[ $target =~ $mr_pattern ]]; then
	job_url="$JOB_ROOT/job/MR-${BASH_REMATCH[2]}"
elif [[ $target =~ $build_pattern ]]; then
	job_url=${BASH_REMATCH[1]}
	build=${BASH_REMATCH[2]}
elif [[ $target =~ $job_pattern ]]; then
	job_url=${BASH_REMATCH[1]}
else
	die "expected an MR number or a Jenkins URL, got '$target'"
fi
job_name=${job_url##*/}

fetch "$job_url/api/json?tree=displayName,inQueue,lastBuild%5Bnumber,building%5D,actions%5BobjectUrl%5D"
title=$(jq -r '.displayName' <<<"$body")
mr_url=$(jq -r '[.actions[]? | .objectUrl // empty][0] // empty' <<<"$body")
[[ $mr_url == */merge_requests/* ]] || mr_url=''

if [[ -z $build ]]; then
	IFS=$'\t' read -r last last_building in_queue < <(jq -r '[.lastBuild.number // 0, .lastBuild.building // false, .inQueue] | @tsv' <<<"$body")
	if ((wait_next || last == 0)) || [[ $last_building == false && $in_queue == true ]]; then
		printf 'Waiting for a %s build after #%s to start…\n' "$job_name" "$last"
		while true; do
			sleep "$interval"
			fetch "$job_url/api/json?tree=lastBuild%5Bnumber%5D"
			build=$(jq -r '.lastBuild.number // 0' <<<"$body")
			((build > last)) && break
		done
	else
		build=$last
	fi
fi

trap 'echo; exit 130' INT

watch_build() {
	build_url="$job_url/$build/"
	printf '👀 Watching %s #%s: %s\n   %s\n' "$job_name" "$build" "$title" "$build_url"
	reported_stages='|'
}
watch_build

while true; do
	fetch "${build_url}api/json?tree=building,result,timestamp,estimatedDuration"
	IFS=$'\t' read -r building result started_ms estimate_ms < <(jq -r '[.building, (.result // "null"), .timestamp, .estimatedDuration] | @tsv' <<<"$body")
	if [[ $building == false && $result == ABORTED ]]; then
		fetch "$job_url/api/json?tree=lastBuild%5Bnumber%5D"
		newer=$(jq -r '.lastBuild.number // 0' <<<"$body")
		if ((newer > build)); then
			printf '\r\033[K#%s was aborted, superseded by #%s\n' "$build" "$newer"
			build=$newer
			watch_build
			continue
		fi
	fi
	[[ $building == false && $result != null ]] && break

	stage=''
	if api "${build_url}wfapi/describe"; then
		stage=$(jq -r '[.stages[]? | select(.status == "IN_PROGRESS") | .name] | join(", ")' <<<"$body")
		while IFS= read -r failed; do
			[[ -z $failed || $reported_stages == *"|$failed|"* ]] && continue
			reported_stages="$reported_stages$failed|"
			afplay /System/Library/Sounds/Basso.aiff &
			banner "💥 $job_name #$build: stage '$failed' failed" "$title" "$build_url" "$mr_url" build
		done < <(jq -r '.stages[]? | select(.status == "FAILED") | .name' <<<"$body")
	fi

	elapsed=$(($(date +%s) - started_ms / 1000))
	remaining=''
	if ((estimate_ms > 0)); then
		left=$((estimate_ms / 1000 - elapsed))
		((left < 0)) && left=0
		remaining=", ~$(format_duration $left) left"
	fi
	printf '\r\033[K[%s] %s elapsed%s%s' "$(date +%H:%M)" "$(format_duration $elapsed)" "$remaining" "${stage:+  ▶ $stage}"
	sleep "$interval"
done
printf '\r\033[K'

fetch "${build_url}api/json?tree=duration,actions%5BfailCount,totalCount%5D"
facts=$(jq -r '
	[.actions[]? | select(.totalCount != null)] as $reports
	| ($reports | map(.failCount) | add // 0) as $failed
	| ["Duration: \(.duration / 1000 | floor | "\(. / 3600 | floor)h\(. % 3600 / 60 | floor | tostring | if length < 2 then "0" + . else . end)m")"]
	+ (if $failed > 0 then ["Failed tests: \($failed) of \($reports | map(.totalCount) | add)"] else [] end)
	| join("\n")' <<<"$body")
if [[ $result != SUCCESS ]] && api "${build_url}wfapi/describe"; then
	failed_stages=$(jq -r '[.stages[]? | select(.status == "FAILED") | .name] | join(", ")' <<<"$body")
	[[ -n $failed_stages ]] && facts="$facts"$'\n'"Failed stages: $failed_stages"
fi

printf '%s #%s finished: %s\n' "$job_name" "$build" "$result"
[[ $title != "$job_name" ]] || title=''
announce "$result" "$job_name #$build $result" "$title" "$facts" "$build_url" "$mr_url"
[[ $result == SUCCESS ]]
